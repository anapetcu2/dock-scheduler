# Neon Postgres — pooled connection string (host contains "-pooler"), used by the running app.
# SQLAlchemy uses NullPool and lets Neon's pooler manage connections (see app/db.py).
DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require

# Neon Postgres — direct (unpooled) connection string, used by Alembic migrations, the importer,
# and (via TEST_DATABASE_URL below) tests.
DATABASE_URL_DIRECT=postgresql+psycopg://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require

# Neon "test" branch, direct connection. conftest.py refuses to run if this equals
# DATABASE_URL_DIRECT or points at the production branch.
TEST_DATABASE_URL=postgresql+psycopg://user:password@ep-example-test.region.aws.neon.tech/dbname?sslmode=require

# Random string used to sign session cookies (itsdangerous). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# "development" or "production". Controls the Secure flag on session cookies, etc.
ENVIRONMENT=development

# Optional overrides for services/booking_rules.py (defaults: 0 and 5).
FIT_MARGIN_FT=0
TIGHT_FIT_FT=5

# Only used locally by `app.cli seed-demo`; never hard-code these.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
